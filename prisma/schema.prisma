datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model DictionaryEntry {
  id          String   @id @default(uuid())
  arabicWord  String
  yazidiWord  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([arabicWord])
  @@index([yazidiWord])
}
